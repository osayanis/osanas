#!/bin/sh
# OsaNAS - lance par le firmware D-Link au demarrage (chk_fun_plug), en root.
# Le volume peut etre encore en lecture seule a ce moment (verification au boot) :
# on attend qu'il soit inscriptible (10 min max), puis on passe la main a start.sh.
# Supprimer ce fichier desactive OsaNAS.
B=/mnt/HD/HD_a2/.osanas
(
  i=0
  while [ $i -lt 120 ]; do
    if mkdir -p $B/log 2>/dev/null && echo "fun_plug: volume inscriptible apres $i essais" > $B/log/fun_plug.log 2>/dev/null; then
      break
    fi
    i=`expr $i + 1`
    sleep 5
  done
  [ -f $B/start.sh ] && sh $B/start.sh > $B/log/start.log 2>&1
) < /dev/null > /dev/null 2>&1 &
exit 0
